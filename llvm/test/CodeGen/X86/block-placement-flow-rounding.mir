# RUN: llc -mtriple=x86_64-unknown-linux-gnu -run-pass=block-placement -verify-machineinstrs --print-machine-bfi %s -o %t 2>&1 | FileCheck %s --check-prefix=FREQ
# RUN: FileCheck %s --check-prefix=ZERO --input-file=%t
# RUN: FileCheck %s --check-prefix=POS --input-file=%t
# RUN: FileCheck %s --check-prefix=MULTI --input-file=%t
#
# A loop with two backedges and a rare entry exit makes the BFI scale large
# enough to preserve a one-unit rounding discrepancy. BB3 has one predecessor
# and one successor. Its frequency is 140736951388160, whereas the separately
# rounded BB2 -> BB3 edge frequency is 140736951388159:
# floor(140736951453695 * 2147483647 / 2147483648).
# Exchanging those two fallthroughs has zero flow benefit. Keep the profitable
# BB4 -> BB1 rotation (BB4 has multiple successors), then leave BB2 -> BB3 as a
# fallthrough instead of reversing the overwhelmingly likely branch.
# The arithmetic in BB3 keeps it above the ordinary tail-duplication threshold.
# FREQ-LABEL: block-frequency-info: flow_rounding
# FREQ: BB2: {{.*}}int = 140736951453695
# FREQ-NEXT: {{.*}}BB3: {{.*}}int = 140736951388160
# ZERO-LABEL: name: flow_rounding
# ZERO: $rsi = INC64r
# ZERO: CMP64ri8 $rdi, 0
# ZERO: $rax = ADD64rr
# ZERO-NEXT: JCC_1 {{.*}}, 0, implicit $eflags
# ZERO-NOT: JMP_1
# ZERO: $rax = IMUL64rri32 $rax, 17
#
# A real alternative fallthrough exposed at BB2 must still allow BB3 -> BB4
# rotation, even though BB3 also has exactly one predecessor and successor.
# POS-LABEL: name: alternative_fallthrough
# POS: $rax = IMUL64rri32 $rax, 17
# POS: $rsi = INC64r
# POS: $rax = ADD64rr
# POS-NEXT: JCC_1 {{.*}}, 1, implicit $eflags
# POS: $rax = XOR64rr
#
# With two incoming paths, BB3's outgoing flow exceeds either incoming path.
# Preserve rotation of this profitable chain as well.
# MULTI-LABEL: name: multiple_predecessors
# MULTI: $rax = IMUL64rri32 $rax, 17
# MULTI: $rsi = INC64r
# MULTI: $rax = ADD64rr
# MULTI-NEXT: JCC_1 {{.*}}, 1, implicit $eflags
#
---
name: flow_rounding
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x7fffffff), %bb.8(0x00000001)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rdi, 0, implicit-def $eflags
    JCC_1 %bb.8, 4, implicit $eflags
    JMP_1 %bb.1
  bb.1:
    successors: %bb.4(0x40000000), %bb.2(0x40000000)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rdi, 0, implicit-def $eflags
    JCC_1 %bb.4, 5, implicit $eflags
    JMP_1 %bb.2
  bb.2:
    successors: %bb.6(0x00000001), %bb.3(0x7fffffff)
    liveins: $rax, $rdi, $rsi
    $rax = ADD64rr $rax, $rsi, implicit-def $eflags
    JCC_1 %bb.6, 0, implicit $eflags
    JMP_1 %bb.3
  bb.3:
    successors: %bb.4(0x80000000)
    liveins: $rax, $rdi, $rsi
    $rax = IMUL64rri32 $rax, 17, implicit-def dead $eflags
    $rax = SAR64ri $rax, 7, implicit-def dead $eflags
    $rax = IMUL64rri32 $rax, 23, implicit-def dead $eflags
    $rax = SAR64ri $rax, 3, implicit-def dead $eflags
    $rax = IMUL64rri32 $rax, 19, implicit-def dead $eflags
    JMP_1 %bb.4
  bb.4:
    successors: %bb.5(0x04000000), %bb.1(0x7c000000)
    liveins: $rax, $rdi, $rsi
    $rsi = INC64r $rsi, implicit-def $eflags
    CMP64rr $rdi, $rsi, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.5
  bb.5:
    successors: %bb.1(0x7fc00000), %bb.7(0x00400000)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rax, 0, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.7
  bb.6:
    TRAP
    RET64
  bb.7:
    liveins: $rax
    RET64 $rax
  bb.8:
    TRAP
    RET64
...

---
name: alternative_fallthrough
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x7fffffff), %bb.8(0x00000001)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rdi, 0, implicit-def $eflags
    JCC_1 %bb.8, 4, implicit $eflags
    JMP_1 %bb.1
  bb.1:
    successors: %bb.4(0x40000000), %bb.2(0x40000000)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rdi, 0, implicit-def $eflags
    JCC_1 %bb.4, 5, implicit $eflags
    JMP_1 %bb.2
  bb.2:
    successors: %bb.9(0x20000000), %bb.3(0x60000000)
    liveins: $rax, $rdi, $rsi
    $rax = ADD64rr $rax, $rsi, implicit-def $eflags
    JCC_1 %bb.9, 0, implicit $eflags
    JMP_1 %bb.3
  bb.3:
    successors: %bb.4(0x80000000)
    liveins: $rax, $rdi, $rsi
    $rax = IMUL64rri32 $rax, 17, implicit-def dead $eflags
    $rax = SAR64ri $rax, 7, implicit-def dead $eflags
    $rax = IMUL64rri32 $rax, 23, implicit-def dead $eflags
    $rax = SAR64ri $rax, 3, implicit-def dead $eflags
    $rax = IMUL64rri32 $rax, 19, implicit-def dead $eflags
    JMP_1 %bb.4
  bb.4:
    successors: %bb.5(0x04000000), %bb.1(0x7c000000)
    liveins: $rax, $rdi, $rsi
    $rsi = INC64r $rsi, implicit-def $eflags
    CMP64rr $rdi, $rsi, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.5
  bb.5:
    successors: %bb.1(0x7fc00000), %bb.7(0x00400000)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rax, 0, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.7
  bb.7:
    liveins: $rax
    RET64 $rax
  bb.8:
    TRAP
    RET64
  bb.9:
    successors: %bb.4(0x80000000)
    liveins: $rax, $rdi, $rsi
    $rax = XOR64rr $rax, $rsi, implicit-def dead $eflags
    $rax = IMUL64rri32 $rax, 29, implicit-def dead $eflags
    $rax = SAR64ri $rax, 5, implicit-def dead $eflags
    $rax = IMUL64rri32 $rax, 31, implicit-def dead $eflags
    JMP_1 %bb.4
...

---
name: multiple_predecessors
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x7fffffff), %bb.8(0x00000001)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rdi, 0, implicit-def $eflags
    JCC_1 %bb.8, 4, implicit $eflags
    JMP_1 %bb.1
  bb.1:
    successors: %bb.3(0x40000000), %bb.2(0x40000000)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rdi, 0, implicit-def $eflags
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2
  bb.2:
    successors: %bb.6(0x00000001), %bb.3(0x7fffffff)
    liveins: $rax, $rdi, $rsi
    $rax = ADD64rr $rax, $rsi, implicit-def $eflags
    JCC_1 %bb.6, 0, implicit $eflags
    JMP_1 %bb.3
  bb.3:
    successors: %bb.4(0x80000000)
    liveins: $rax, $rdi, $rsi
    $rax = IMUL64rri32 $rax, 17, implicit-def dead $eflags
    $rax = SAR64ri $rax, 7, implicit-def dead $eflags
    $rax = IMUL64rri32 $rax, 23, implicit-def dead $eflags
    $rax = SAR64ri $rax, 3, implicit-def dead $eflags
    $rax = IMUL64rri32 $rax, 19, implicit-def dead $eflags
    JMP_1 %bb.4
  bb.4:
    successors: %bb.5(0x04000000), %bb.1(0x7c000000)
    liveins: $rax, $rdi, $rsi
    $rsi = INC64r $rsi, implicit-def $eflags
    CMP64rr $rdi, $rsi, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.5
  bb.5:
    successors: %bb.1(0x7fc00000), %bb.7(0x00400000)
    liveins: $rax, $rdi, $rsi
    CMP64ri8 $rax, 0, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.7
  bb.6:
    TRAP
    RET64
  bb.7:
    liveins: $rax
    RET64 $rax
  bb.8:
    TRAP
    RET64
...
